{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "outDir": "dist",
        "noUnusedLocals": false,
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "skipLibCheck": true
    },
    "include": ["src"]
}
